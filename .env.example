# coo-docs 部署配置。复制为 .env 后填写，或直接运行 scripts/install.sh 自动生成。
#
# ⚠️ .env 已在 .gitignore 中，**不要**提交进版本库。
# ⚠️ 口令请只用字母和数字：MYSQL_PASSWORD 会被拼进 DATABASE_URL，
#    其中的 @ : / ? # 会被当作 URL 分隔符，导致后端连不上库且报错难懂。
#    install.sh 生成的口令已限定为字母数字。
#
# ⚠️ MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD 只在**数据库首次初始化时**生效。
#    库已经建起来之后再改这里，不会改掉库里的口令，只会让后端连不上。
#    轮换已有部署的口令见《部署与运维手册》§11.3。

# ── 数据库 ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=coo
MYSQL_USER=coo
MYSQL_PASSWORD=

# ── 对象存储：NAS 归档走的 S3 兼容接口 ─────────────────────
# 后端的 S3_ACCESS_KEY / S3_SECRET_KEY 直接引用这两个值，不必重复填写
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=coo-nas
S3_REGION=us-east-1

# ── 站点 ──────────────────────────────────────────────────
# 时区影响 NAS 定时同步与超期判断，请按客户所在地填写
TIMEZONE=Asia/Bangkok
CORS_ORIGINS=http://localhost,http://localhost:5173

# ── 备份加密 ──────────────────────────────────────────────
# 备份中含 JWT 签名密钥明文、NAS 访问密钥与全部密码哈希。
# 设了这一项，backup_mysql.sh 才会加密产物；备份要离开本机就必须设。
# ⚠️ 此口令必须与备份分开保管——和备份放在一起等于没加密。
BACKUP_ENCRYPT_PASS=
