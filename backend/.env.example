# COO 资料收集平台 - 后端环境变量示例
# 复制为 .env 后按实际修改

APP_NAME=COO 资料收集平台
DEBUG=false

# 数据库：本地开发用 SQLite；生产改为 MySQL
# DATABASE_URL=mysql+pymysql://coo:password@mysql:3306/coo?charset=utf8mb4
DATABASE_URL=sqlite:///./coo.db

# 安全（生产务必修改 SECRET_KEY）
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_LOGIN_FAILURES=5
LOGIN_LOCK_MINUTES=30

# 文件存储
UPLOAD_DIR=./data/uploads
NAS_ROOT=./data/nas
MAX_FILE_MB=100

# NAS 同步
NAS_SYNC_TIME=01:00
PROJECT_CODE=Bintelli-US

# 前端开发地址（CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
