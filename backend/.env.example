# COO 资料收集平台 - 后端环境变量示例
# 复制为 .env 后按实际修改

APP_NAME=COO 资料收集平台
DEBUG=false

# 数据库：本地开发用 SQLite；生产改为 MySQL
# DATABASE_URL=mysql+pymysql://coo:password@mysql:3306/coo?charset=utf8mb4
DATABASE_URL=sqlite:///./coo.db

# 安全：JWT 密钥不在此配置。首次启动自动随机生成并存入数据库（system_settings），
# 超管可在「组织管理 → 安全设置」界面轮换。
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 种子数据：true=创建演示账号（admin/admin123 等，仅限开发验收）；生产务必 false
SEED_DEMO_DATA=true

# 站点时区（NAS 定时同步与超期判断按此计算）
TIMEZONE=Asia/Bangkok
MAX_LOGIN_FAILURES=5
LOGIN_LOCK_MINUTES=30

# 文件存储
UPLOAD_DIR=./data/uploads
NAS_ROOT=./data/nas
MAX_FILE_MB=100

# NAS 归档：S3 兼容接口（MinIO / 群晖 / 威联通 / 云对象存储）
# 留空则退化为本地目录同步（NAS_ROOT）
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=coo-nas
S3_REGION=us-east-1
S3_USE_SSL=false

# NAS 同步
NAS_SYNC_TIME=01:00
PROJECT_CODE=Bintelli-US

# 前端开发地址（CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
